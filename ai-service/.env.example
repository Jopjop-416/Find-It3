# Environment Variables — Find-It AI Service
# Copy this file to .env and fill in the values

# ── Supabase (SERVER-SIDE ONLY — NEVER expose to frontend) ───────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBrdm1ieW9qbnBnemNobWFpZGZnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDczNzkyOSwiZXhwIjoyMDk2MzEzOTI5fQ.3HlZBgNhwc2GTDojrGFl5uAwFOnb4j0UevsteuVTawo

# ── OpenCLIP Model ────────────────────────────────────────────────────────────
# ViT-B-32 with openai weights produces 512-dimensional embeddings,
# which matches the vector(512) column already in the Supabase database.
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Matching ──────────────────────────────────────────────────────────────────
# Minimum cosine similarity to include a candidate from vector search (0.0-1.0)
VECTOR_MATCH_THRESHOLD=0.30
# Maximum number of candidates to return from vector search
VECTOR_MATCH_COUNT=20
